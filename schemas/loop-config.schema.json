{
  "$defs": {
    "ContextConfig": {
      "additionalProperties": false,
      "description": "Token budgets for the whole prompt and for the harness share of it.\n\n``repo_map`` adds the repository's file list to the task message at the first step.",
      "properties": {
        "budget_tokens": {
          "default": 24000,
          "exclusiveMinimum": 0,
          "title": "Budget Tokens",
          "type": "integer"
        },
        "harness_budget_tokens": {
          "default": 4000,
          "exclusiveMinimum": 0,
          "title": "Harness Budget Tokens",
          "type": "integer"
        },
        "repo_map": {
          "default": false,
          "title": "Repo Map",
          "type": "boolean"
        }
      },
      "title": "ContextConfig",
      "type": "object"
    },
    "FinishGateConfig": {
      "additionalProperties": false,
      "description": "What runs when the student calls ``finish``.",
      "properties": {
        "max_retries": {
          "default": 1,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "reread_task": {
          "default": true,
          "title": "Reread Task",
          "type": "boolean"
        },
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "pytest -q",
          "title": "Run"
        }
      },
      "title": "FinishGateConfig",
      "type": "object"
    },
    "HookConfig": {
      "additionalProperties": false,
      "description": "One fixed step the loop adds; it runs in the sandbox like any tool call.\n\n``event``: ``post_tool`` runs after a successful call of one of ``tools`` (any tool when empty);\n``before_finish`` runs when the student calls ``finish``, before the finish gate.\n``run`` is a shell command whose output the student sees; ``inject`` is a fixed note.",
      "properties": {
        "event": {
          "enum": [
            "post_tool",
            "before_finish"
          ],
          "title": "Event",
          "type": "string"
        },
        "inject": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inject"
        },
        "run": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run"
        },
        "tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "event"
      ],
      "title": "HookConfig",
      "type": "object"
    },
    "LoopDetectionConfig": {
      "additionalProperties": false,
      "description": "Stop after this many identical calls with no workspace change.",
      "properties": {
        "identical_calls": {
          "default": 3,
          "minimum": 2,
          "title": "Identical Calls",
          "type": "integer"
        }
      },
      "title": "LoopDetectionConfig",
      "type": "object"
    },
    "ReasoningConfig": {
      "additionalProperties": false,
      "description": "How much the student reasons; sent to the runner with every request.",
      "properties": {
        "effort": {
          "default": "low",
          "enum": [
            "off",
            "low",
            "high"
          ],
          "title": "Effort",
          "type": "string"
        }
      },
      "title": "ReasoningConfig",
      "type": "object"
    },
    "ToolOutputConfig": {
      "additionalProperties": false,
      "description": "How much of each tool's output the student sees.",
      "properties": {
        "max_chars": {
          "default": 4000,
          "exclusiveMinimum": 0,
          "title": "Max Chars",
          "type": "integer"
        }
      },
      "title": "ToolOutputConfig",
      "type": "object"
    },
    "ToolsConfig": {
      "additionalProperties": false,
      "description": "Which tools the student gets, and the shape of two of them.\n\n``read_line_numbers`` prefixes ``read_file`` output with line numbers, as ``cat -n``\ndoes. ``edit_strips_line_numbers`` lets ``edit_file`` take ``old`` text the student\ncopied with those prefixes: when every line of ``old`` has one, they are removed from\n``old`` and from ``new`` before matching.",
      "properties": {
        "edit_strips_line_numbers": {
          "default": false,
          "title": "Edit Strips Line Numbers",
          "type": "boolean"
        },
        "enabled": {
          "default": [
            "read_file",
            "list_dir",
            "search",
            "edit_file",
            "write_file",
            "bash"
          ],
          "items": {
            "type": "string"
          },
          "title": "Enabled",
          "type": "array"
        },
        "read_line_numbers": {
          "default": true,
          "title": "Read Line Numbers",
          "type": "boolean"
        }
      },
      "title": "ToolsConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The whole ``loop.yaml`` file.",
  "properties": {
    "context": {
      "$ref": "#/$defs/ContextConfig",
      "default": {
        "budget_tokens": 24000,
        "harness_budget_tokens": 4000,
        "repo_map": false
      }
    },
    "finish_gate": {
      "$ref": "#/$defs/FinishGateConfig",
      "default": {
        "max_retries": 1,
        "reread_task": true,
        "run": "pytest -q"
      }
    },
    "hooks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HookConfig"
      },
      "maxItems": 4,
      "title": "Hooks",
      "type": "array"
    },
    "loop_detection": {
      "$ref": "#/$defs/LoopDetectionConfig",
      "default": {
        "identical_calls": 3
      }
    },
    "max_steps": {
      "default": 40,
      "exclusiveMinimum": 0,
      "title": "Max Steps",
      "type": "integer"
    },
    "reasoning": {
      "$ref": "#/$defs/ReasoningConfig",
      "default": {
        "effort": "low"
      }
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "tool_output": {
      "$ref": "#/$defs/ToolOutputConfig",
      "default": {
        "max_chars": 4000
      }
    },
    "tools": {
      "$ref": "#/$defs/ToolsConfig",
      "default": {
        "edit_strips_line_numbers": false,
        "enabled": [
          "read_file",
          "list_dir",
          "search",
          "edit_file",
          "write_file",
          "bash"
        ],
        "read_line_numbers": true
      }
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "LoopConfig",
  "type": "object"
}
