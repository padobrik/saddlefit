{
  "$defs": {
    "HeldOutCounts": {
      "additionalProperties": false,
      "description": "Held-out aggregates only: wins (unsolved \u2192 solved) and losses (solved \u2192 unsolved).",
      "properties": {
        "losses": {
          "minimum": 0,
          "title": "Losses",
          "type": "integer"
        },
        "runs_per_task": {
          "minimum": 1,
          "title": "Runs Per Task",
          "type": "integer"
        },
        "tasks": {
          "minimum": 0,
          "title": "Tasks",
          "type": "integer"
        },
        "wins": {
          "minimum": 0,
          "title": "Wins",
          "type": "integer"
        }
      },
      "required": [
        "wins",
        "losses",
        "tasks",
        "runs_per_task"
      ],
      "title": "HeldOutCounts",
      "type": "object"
    },
    "TrainCounts": {
      "additionalProperties": false,
      "description": "Training-batch tasks solved before and after the change, on the same seeds.",
      "properties": {
        "after": {
          "minimum": 0,
          "title": "After",
          "type": "integer"
        },
        "before": {
          "minimum": 0,
          "title": "Before",
          "type": "integer"
        },
        "runs_per_task": {
          "minimum": 1,
          "title": "Runs Per Task",
          "type": "integer"
        },
        "tasks": {
          "minimum": 1,
          "title": "Tasks",
          "type": "integer"
        }
      },
      "required": [
        "before",
        "after",
        "tasks",
        "runs_per_task"
      ],
      "title": "TrainCounts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "context_tokens_added": {
      "title": "Context Tokens Added",
      "type": "integer"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    },
    "harness_commit": {
      "pattern": "^[0-9a-f]{7,64}$",
      "title": "Harness Commit",
      "type": "string"
    },
    "held_out": {
      "anyOf": [
        {
          "$ref": "#/$defs/HeldOutCounts"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
      "title": "Id",
      "type": "string"
    },
    "level": {
      "enum": [
        "mechanics",
        "tools",
        "text",
        "reasoning"
      ],
      "title": "Level",
      "type": "string"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "model_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Digest"
    },
    "proposal_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "accepted",
        "rejected",
        "pruned"
      ],
      "title": "Status",
      "type": "string"
    },
    "train": {
      "$ref": "#/$defs/TrainCounts"
    }
  },
  "required": [
    "schema_version",
    "id",
    "proposal_id",
    "model",
    "level",
    "files",
    "harness_commit",
    "status",
    "train",
    "context_tokens_added"
  ],
  "title": "ChangeRecord",
  "type": "object"
}
